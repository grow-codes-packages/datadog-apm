# Service-owned (not generated by sdk-kit): live checks against Datadog APM through a real Datadog
# Agent (GRO-1385). Run from the repository root with `make -C live live` (or `make live` here).
#
#   DATADOG_API_KEY=... DATADOG_APP_KEY=... [DATADOG_SITE=datadoghq.eu] make -C live live
#
# Without the keys the suite prints "skipped: no credentials" and exits 0. The package is
# installed from ./python into live/.venv (PYTHON picks the interpreter, default python3). Unless
# GROW_DATADOG_APM_URL or DD_AGENT_HOST points at a running Agent, run.sh starts a datadog/agent
# container (Docker, ports on 127.0.0.1 only) and removes it afterwards.

SHELL := /bin/sh
PYTHON ?= python3
VENV ?= .venv

.PHONY: live lint format clean

live:
	@PYTHON="$(PYTHON)" LIVE_VENV="$(VENV)" sh ./run.sh

$(VENV)/bin/ruff:
	$(PYTHON) -m venv $(VENV)
	$(VENV)/bin/python -m pip install --quiet "ruff>=0.8"

lint: $(VENV)/bin/ruff
	$(VENV)/bin/ruff check .
	$(VENV)/bin/ruff format --check .

format: $(VENV)/bin/ruff
	$(VENV)/bin/ruff format .
	$(VENV)/bin/ruff check --fix .

clean:
	rm -rf $(VENV) .ruff_cache __pycache__
